# Frontend and API are both on Vercel, so the frontend calls /api on the same domain.
# Only set VITE_API_URL if the API is hosted somewhere else.
# VITE_API_URL=https://your-api.example.com/api

# Ops logins for check-in/dashboard/admin, comma-separated email:password pairs.
# Keep real values in Vercel and your local .env only.
VITE_OPS_ACCOUNTS=staff@example.com:change-me,another@example.com:change-me-too
